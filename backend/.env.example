# ResearchPulse Backend Configuration
# ========================================

# Database connection: defaults to local SQLite if left empty or using sqlite:///
DATABASE_URL=sqlite:///./researchpulse.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/researchpulse

# AI Model settings:
# If OPENAI_API_KEY is omitted or empty, the built-in Heuristic Agentic Engine is used seamlessly.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Research Sources:
ARXIV_BASE_URL=http://export.arxiv.org/api/query
DEFAULT_POLL_INTERVAL_HOURS=6

# Server settings:
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
